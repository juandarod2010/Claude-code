# ------------------------------------------------------------------
# Complyo — variables de entorno
# Copia este fichero a .env y rellena lo que tengas.
# La aplicación arranca SIN ninguna de estas variables (modo MOCK).
# ------------------------------------------------------------------

# MODO MOCK
# true  -> los leads y los informes se guardan en localStorage del navegador.
#          No hace falta ninguna cuenta ni clave. Es el modo por defecto.
# false -> se usa Supabase. Requiere las dos variables de abajo.
VITE_MOCK=true

# SUPABASE (solo si VITE_MOCK=false)
# Panel de Supabase -> Project Settings -> API
# La clave "anon" es pública por diseño: puede ir en el navegador siempre que
# Row Level Security esté activado (lo está, ver /supabase/migrations/).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PANEL INTERNO (/admin y /prospeccion)
# Contraseña única para ti. Si se deja vacía se usa "complyo-dev" en desarrollo.
# AVISO: esta contraseña viaja al navegador dentro del bundle. Es un portero
# para evitar visitas casuales, NO es seguridad real. Ver DECISIONS.md.
VITE_ADMIN_PASSWORD=
